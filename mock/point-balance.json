{
  "stateGroups": [
    {
      "title": "Page",
      "states": [
        "loading",
        "error"
      ],
      "descriptions": {
        "loading": "The page is waiting for its data: the header and grey placeholder cards.",
        "error": "The data could not be loaded: a message and “Try again”."
      }
    },
    {
      "title": "Coin Balance",
      "states": [
        "empty",
        "expiring"
      ],
      "descriptions": {
        "empty": "Balance is 0: no available, pending or expiring coins. Tabs still show their lists.",
        "expiring": "1,200 coins expire within 10 days: red warning under the balance; that lot is highlighted in Available."
      }
    },
    {
      "title": "Tabs",
      "states": [
        "available-empty",
        "expired-empty",
        "history-empty",
        "has-used",
        "more-error"
      ],
      "descriptions": {
        "available-empty": "The Available tab has no lots: it shows “No available coins.”",
        "expired-empty": "The Expired tab has nothing: “No expired coins in this period.”",
        "history-empty": "The History tab has nothing: “No activity in this period.”",
        "has-used": "Adds fully used lots: two still before expiry, shown muted in a “Fully used” section at the end of Available (Remain 0), and one used up and then expired, shown in Expired with “Expired 0” (inside Last 7 days).",
        "more-error": "The next page of a long list failed to load: “Couldn’t load more. Try again” at the end of the list (open the History tab with Last 30 days)."
      }
    }
  ],
