{
  "stateGroups": [
    {
      "title": "Sign-in",
      "states": [
        "guest"
      ],
      "labels": {
        "guest": "Guest (not signed in)"
      },
      "descriptions": {
        "guest": "Not signed in: “How to start” with four steps (Create your free account first), the rate line, “Coins per lot depend on your trading account type.” and Sign up / Log in in place of today's figures; then the rules and Terms; no account, no History tab, no trade button."
      }
    },
    {
      "title": "Page",
      "states": [
        "ended",
        "loading",
        "error"
      ],
      "descriptions": {
        "ended": "The programme is over: under the cup only “This program has ended”. No figures, no account, no rules or history, nothing to tap.",
        "loading": "The page is waiting for its data: the header and grey placeholder cards.",
        "error": "The data could not be loaded: a message and “Try again”."
      }
    },
    {
      "title": "Participation",
      "states": [
        "needs-kyc",
        "needs-deposit"
      ],
      "descriptions": {
        "needs-kyc": "User has not passed KYC and has no trading account yet. The Today card shows “How to start” (step 1 is the one to do) with the rate range and “Verify my account”. No account picker and no rates table.",
        "needs-deposit": "User passed KYC but has not made a first deposit and has no trading account yet. The Today card shows “How to start” (step 1 checked, step 2 is the one to do) with the rate range and “Deposit now”. No account picker and no rates table."
      }
    },
    {
      "title": "Today trading task",
      "states": [
        "first-trade",
        "credited",
        "delayed",
        "capped",
        "no-trades-today"
      ],
      "descriptions": {
        "capped": "Today's max coins reached: capped message on the Today card, plain “Trade now” button.",
        "no-trades-today": "No trades yet today: 0 lots and 0 coins, with a hint to make the first trade.",
        "credited": "All of today's coins are in the balance: the Today card reads “Credited to your balance” instead of the earning line.",
        "delayed": "Programme that credits coins some days after the trading day (not used at launch; not tuned yet). The rule reads “credited 1 day after the trading day”. The Today card shows 0 lots and 0 coins all day even after trading, with no line under the figures (not even “after your first trade”), and today has no row in History until its coins arrive.",
        "first-trade": "The user has just closed the first trade of the day and its coins have not arrived yet: 0 lots and 0 coins, with “Coins are being credited to your balance”. Lasts up to 15 minutes."
      }
    },
    {
      "title": "Activity",
      "states": [
        "activity-empty"
      ],
      "descriptions": {
        "activity-empty": "The backend sent no recent activity: the “Trader … just redeemed / earned” card is hidden (Home and Earn)."
      }
    },
    {
      "title": "Trading account",
      "states": [
        "single-account",
        "ineligible-selected",
        "no-account"
      ],
      "descriptions": {
        "single-account": "User has only one trading account: a fixed field instead of the account picker.",
        "ineligible-selected": "The selected trading account belongs to an MT5 group that cannot take part in the programme, for example an A-Book group or any group not listed in the programme config. Shows a warning and “Switch to an eligible account”.",
        "no-account": "User passed KYC and made a first deposit but has no live trading account (only demo accounts, or the live account was removed). Instead of the account picker and rates: a short message, the rate range and “Open a trading account”."
      }
    },
    {
      "title": "Account tier",
      "states": [
        "tier-micro",
        "tier-standard",
        "tier-top",
        "tier-reached",
        "tier-unknown"
      ],
      "labels": {
        "tier-micro": "Tier: Micro",
        "tier-standard": "Tier: Standard",
        "tier-top": "Tier: Platinum (top)",
        "tier-reached": "Tier: deposit reached",
        "tier-unknown": "Tier: unknown group"
      },
      "descriptions": {
        "tier-micro": "Selected account is Micro (MT5 group Direct\\Mini400), $50 deposited: the upgrade row offers Standard; the sheet asks for $150 more.",
        "tier-standard": "Selected account is Standard (Direct\\Mini10), $450 deposited: the upgrade row offers VIP; the sheet asks for $550 more.",
        "tier-top": "Selected account is Platinum (Direct\\MIVIP), the top tier: a quiet row (crown, no border, grey) reads “Platinum: our highest rates”; the sheet says the account is on the top tier and offers to trade.",
        "tier-reached": "Selected account is still VIP (Direct\\VIP1) but has $5,200 deposited, past Platinum's $5,000 (the dealing team changes groups by hand): the sheet says the upgrade is on its way instead of asking for more.",
        "tier-unknown": "Selected account's MT5 group is not one of the four tiers (1F\\Direct\\Mini10, matched exactly): no tier label and no upgrade row."
      }
    }
  ],
