    {
      "title": "Today trading task",
      "states": [
        "credited",
        "delayed",
        "capped",
        "no-trades-today",
        "market-closed"
      ],
      "descriptions": {
        "capped": "Today's max coins reached: capped message on the Today card, plain “Trade now” button.",
        "no-trades-today": "No trades yet today: 0 lots and 0 coins, with a hint to make the first trade.",
        "market-closed": "Weekend (markets closed): the live “Trader … just earned … coins” line is hidden. It runs Sunday 17:00 to Friday 17:00 UTC (Monday to Friday, GMT+7).",
        "credited": "All of today's coins are in the balance: the Today card reads “Credited to your balance” instead of the earning line.",
        "delayed": "Programme that credits coins some days after the trading day (not used at launch). The rule reads “credited 3 days after the trading day”; the Today card shows the lots, 0 coins and no status line; today has no row in History until its coins arrive."
      }
    },
    {
      "title": "Trading account",
      "states": [
        "single-account",
        "ineligible-selected",
        "no-account"
      ],
      "descriptions": {
        "single-account": "User has only one trading account: a fixed field instead of the account picker.",
        "ineligible-selected": "The selected trading account belongs to an MT5 group that cannot take part in the programme, for example an A-Book group or any group not listed in the programme config. Shows a warning and “Switch to an eligible account”.",
        "no-account": "User passed KYC and made a first deposit but has no live trading account (only demo accounts, or the live account was removed). Instead of the account picker and rates: a short message, the rate range and “Open a trading account”."
      }
    }
  ],
