{
  "stateGroups": [
    {
      "title": "Sign-in",
      "states": [
        "guest"
      ],
      "labels": {
        "guest": "Guest (not signed in)"
      },
      "descriptions": {
        "guest": "Not signed in (the app opened the page without a token): balance 0; Redeem, the balance, reward cards and Explore all rewards open the sign-up sheet (“How to start” with “Create your free account” first, Sign up, Log in). Rewards and recent activity still show."
      }
    },
    {
      "title": "Page",
      "states": [
        "first-visit",
        "no-task-trading",
        "ended",
        "loading",
        "error"
      ],
      "labels": {
        "no-task-trading": "No Task: Trading",
        "first-visit": "First visit (tour)"
      },
      "descriptions": {
        "no-task-trading": "The Trading Task is not shown to this user, because: (1) the Trading Task has been turned off; (2) the Trading Task has been blocked for this user (reason set in config, e.g. blacklist, A-Book); or (3) the Trading Task has been hidden from all users. The “earn coins” card in the rewards grid and the Earn tab are hidden.",
        "first-visit": "Treats this as the first time Home is opened on the device: the guided tour opens by itself. Without it, the tour opens only once per device, or from the help button in the header.",
        "loading": "The page is waiting for its data: the header and grey placeholder cards.",
        "error": "The data could not be loaded: a message and “Try again”.",
        "ended": "The programme is over: the “earn coins” card in the rewards grid is hidden; the grid shows rewards only."
      }
    },
    {
      "title": "Participation",
      "states": [
        "needs-kyc",
        "needs-deposit"
      ],
      "descriptions": {
        "needs-kyc": "User has not passed KYC yet. Redeem (balance and reward cards) opens a sheet with “How to start” (step 1 is the one to do, button “Verify my account”) instead of going to Tada.",
        "needs-deposit": "User passed KYC but has not made a first deposit. Redeem (balance and reward cards) opens a sheet with “How to start” (step 1 checked, step 2 is the one to do, button “Deposit now”) instead of going to Tada."
      }
    },
    {
      "title": "Coin Balance",
      "states": [
        "empty",
        "expiring"
      ],
      "descriptions": {
        "empty": "Balance is 0: no available, pending or expiring coins.",
        "expiring": "1,200 coins expire within 10 days: red warning under the balance."
      }
    },
    {
      "title": "Activity",
      "states": [
        "activity-empty"
      ],
      "descriptions": {
        "activity-empty": "The backend sent no recent activity: the “Trader … just redeemed / earned” card is hidden (Home and Earn)."
      }
    },
    {
      "title": "Rewards grid",
      "states": [
        "rewards-empty",
        "big-prices"
      ],
      "labels": {
        "big-prices": "Big prices",
        "rewards-empty": "No rewards"
      },
      "descriptions": {
        "big-prices": "Some rewards cost a lot of coins (99,999 to 12,500,000). When one price and its Redeem do not fit on one row (about 6 digits and up), Redeem moves under the price, at the right, on every card of the grid; the number is never cut.",
        "rewards-empty": "The rewards API sent nothing, or failed (it is a different backend): the “Redeem coins for rewards” title and the grid (with its “Earn more coins” card) are left out; the rest of Home stays, including “Looking for something else?”."
      }
    },
    {
      "title": "Daily check-in (future)",
      "states": [
        "check-in"
      ],
      "descriptions": {
        "check-in": "Shows the daily check-in card (future feature, not launched)."
      }
    }
  ],
