        "banner-gold": "C: yellow, dark text"
      },
      "descriptions": {
        "banner-light": "PREVIEW ONLY, for review: a light white-to-lilac banner with dark purple text, against the deep blue page.",
        "banner-gold": "PREVIEW ONLY, for review: a yellow-to-orange banner with dark text, the coins' colour."
      }
    },
    {
      "title": "Card colour in dark mode (review)",
      "exclusive": true,
      "defaultLabel": "4: Current (dark grey)",
      "states": [
        "cards-light",
        "cards-blue",
        "cards-glass"
