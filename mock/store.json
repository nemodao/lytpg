      "labels": {
        "cards-light": "1: As in light mode",
        "cards-blue": "2: Blue-black, lighter",
        "cards-glass": "3: Frosted glass"
      },
      "descriptions": {
        "cards-light": "PREVIEW ONLY, for review, dark mode only: the reward and voucher cards keep their light-mode look (white card, dark text, lilac picture backdrop) on the dark page.",
        "cards-blue": "PREVIEW ONLY, for review, dark mode only: cards in a lighter black tinted with the brand blue, the picture backdrop a brighter blue.",
        "cards-glass": "PREVIEW ONLY, for review, dark mode only: frosted-glass cards (see-through white with a blur) over the blue background, the picture backdrop a soft white glow."
      }
